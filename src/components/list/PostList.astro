---
import { withBase } from '../../lib/url';
import { formatDate, isoDate, tagSlug, type PostItem } from './post-item';

interface Props {
  items: PostItem[];
  emptyText?: string;
}

const { items, emptyText = 'Belum ada riset yang terbit.' } = Astro.props;
---

{
  items.length === 0 ? (
    <p class="post-list__empty">{emptyText}</p>
  ) : (
    <ul class="post-list">
      {items.map((post) => (
        <li class="post">
          <h3 class="post__title">
            <a class="post__link" href={post.href}>
              {post.title}
            </a>
          </h3>
          <p class="post__desc">{post.description}</p>
          <p class="post__meta">
            <time datetime={isoDate(post.date)}>{formatDate(post.date)}</time>
            <span class="post__dot" aria-hidden="true">·</span>
            <span>{post.readingMinutes} menit baca</span>
          </p>
          {post.tags.length > 0 && (
            <p class="post__tags">
              <span class="visually-hidden">Tag: </span>
              {post.tags.map((tag, i) => (
                <>
                  {i > 0 && <span class="post__dot" aria-hidden="true">·</span>}
                  <a class="post__tag" href={withBase(`/tags/${tagSlug(tag)}/`)}>
                    {tag}
                  </a>
                </>
              ))}
            </p>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  .post {
    position: relative;
    padding-block: var(--s5);
    border-top: 1px solid var(--rule);
  }

  .post__title {
    margin: 0 0 var(--s2);
    font-family: var(--serif);
    font-size: clamp(1.125rem, 1.05rem + 0.4vw, 1.3125rem);
    line-height: 1.3;
  }

  .post__link {
    color: var(--ink);
    text-decoration: none;
    text-wrap: balance;
  }

  /* Whole row is clickable; tag links sit above this layer. */
  .post__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post__link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    text-decoration-color: var(--accent);
  }

  .post__link:focus-visible {
    outline: none;
  }

  /* Ring the whole row rather than just the title text. */
  .post:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: var(--s2);
    border-radius: var(--radius);
  }

  .post__desc {
    margin: 0 0 var(--s3);
    color: var(--ink);
    max-width: var(--measure);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2);
    margin: 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.01em;
    color: var(--muted);
  }

  .post__dot {
    color: var(--rule);
  }

  .post__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2);
    margin: var(--s2) 0 0;
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .post__tag {
    position: relative;
    z-index: 1;
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .post__tag:hover {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  .post-list__empty {
    margin: 0;
    padding-block: var(--s5);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
