---
/**
 * CodeBlock — dipakai oleh Prose.astro untuk setiap `<pre>` hasil render markdown.
 *
 * Markdown tidak membawa meta fence ke komponen, jadi nama berkas diambil dari
 * baris komentar pertama di dalam blok kode, dengan bentuk:
 *   // path: public/upload.php    (# untuk shell/yaml, -- untuk sql)
 * Baris itu dipakai sebagai label lalu dihapus dari tampilan.
 */
interface Props {
  /** HTML dalam blok kode (`<code>…</code>` hasil shiki). */
  html?: string;
  /** Nama berkas eksplisit; menang atas baris `path:`. */
  file?: string;
  lang?: string;
}

const { file, lang = '' } = Astro.props;
let html = Astro.props.html ?? String((await Astro.slots.render('default')) ?? '');
let label = file ?? '';

const firstLine = html.indexOf('<span class="line">');
const secondLine = firstLine === -1 ? -1 : html.indexOf('<span class="line">', firstLine + 1);

if (firstLine !== -1 && secondLine !== -1) {
  const text = html.slice(firstLine, secondLine).replace(/<[^>]*>/g, '').trim();
  const match = text.match(/^(?:\/\/|#|--|\/\*)\s*(?:path|file):\s*(\S+?)(?:\s*\*\/)?$/i);
  if (match) {
    label = label || match[1];
    html = html.slice(0, firstLine) + html.slice(secondLine);
  }
}

const shown = label || lang || 'kode';
---

<figure class="codeblock">
  <div class="codeblock__bar">
    <span class="codeblock__file">{shown}</span>
    <button
      type="button"
      class="codeblock__copy"
      data-copy
      aria-label={`Salin kode dari ${shown}`}
    >
      <span class="codeblock__label" data-copy-label aria-live="polite">Salin</span>
    </button>
  </div>
  <pre class="codeblock__pre" tabindex="0" data-language={lang}><Fragment set:html={html} /></pre>
</figure>

<script>
  const COPY = 'Salin';
  const DONE = 'Tersalin';

  async function writeClipboard(text: string): Promise<void> {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const area = document.createElement('textarea');
    area.value = text;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.opacity = '0';
    document.body.appendChild(area);
    area.select();
    document.execCommand('copy');
    area.remove();
  }

  document.addEventListener('click', async (event) => {
    const el = event.target as HTMLElement | null;
    const button = el?.closest<HTMLButtonElement>('[data-copy]');
    if (!button) return;

    const pre = button.closest('.codeblock')?.querySelector('pre');
    if (!pre) return;

    try {
      await writeClipboard(pre.textContent ?? '');
    } catch {
      return;
    }

    const label = button.querySelector<HTMLElement>('[data-copy-label]');
    if (label) label.textContent = DONE;
    button.dataset.state = 'done';
    window.setTimeout(() => {
      if (label) label.textContent = COPY;
      button.dataset.state = '';
    }, 2000);
  });
</script>

<style>
  .codeblock {
    margin: 0 0 var(--s5);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .codeblock__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    padding: var(--s1) var(--s2) var(--s1) var(--s4);
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .codeblock__file {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }

  .codeblock__copy {
    flex: none;
    padding: 2px var(--s2);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .codeblock__copy:hover {
    color: var(--ink);
    border-color: var(--muted);
  }

  .codeblock__copy[data-state='done'] {
    color: var(--accent);
    border-color: var(--accent);
  }

  .codeblock__pre {
    margin: 0;
    padding: var(--s4);
    border: 1px solid var(--rule);
    border-width: 1px 0 0;
    border-radius: 0;
    background: var(--surface);
    font-family: var(--mono);
    font-size: 0.8125rem;
    line-height: 1.55;
    overflow-x: auto;
    tab-size: 2;
  }

  .codeblock__pre :global(code) {
    font-family: var(--mono);
    font-size: inherit;
    border: 0;
    padding: 0;
    background: none;
  }
</style>

<style is:global>
  /* Dual-theme shiki: token membawa warna terang inline + --shiki-dark. */
  :root[data-theme='dark'] .codeblock__pre span {
    color: var(--shiki-dark, inherit) !important;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .codeblock__pre span {
      color: var(--shiki-dark, inherit) !important;
    }
  }
</style>
