---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { collectTags } from '../../components/list/post-item';
import { withBase } from '../../lib/url';

const published = await getCollection('research', ({ data }) => !data.draft);
const tags = collectTags(published);
const total = published.length;
---

<Base
  title="Arsip tag"
  description="Semua tag riset di kagurasaka, diurutkan berdasarkan jumlah artikel."
>
  <div class="wrap">
    <p class="eyebrow">Arsip</p>
    <h1>Tag</h1>
    <p class="tags__lead">
      {total} riset terbit, {tags.length} tag.
    </p>

    {
      tags.length === 0 ? (
        <p class="tags__empty">Belum ada tag — arsip sedang disusun.</p>
      ) : (
        <ul class="tags">
          {tags.map((tag) => (
            <li class="tags__row">
              <a class="tags__link" href={withBase(`/tags/${tag.slug}/`)}>
                {tag.label}
              </a>
              <span class="tags__count" aria-hidden="true">
                {String(tag.count).padStart(2, '0')}
              </span>
              <span class="visually-hidden">
                , {tag.count} riset
              </span>
            </li>
          ))}
        </ul>
      )
    }

    <p class="tags__back">
      <a href={withBase('/research/')}>Semua riset →</a>
    </p>
  </div>
</Base>

<style>
  .tags__lead {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.8125rem;
    margin-bottom: var(--s6);
  }

  .tags {
    list-style: none;
    margin: 0 0 var(--s6);
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  .tags__row {
    display: flex;
    align-items: baseline;
    gap: var(--s4);
    padding-block: var(--s3);
    border-top: 1px solid var(--rule);
  }

  .tags__link {
    font-family: var(--serif);
    font-size: 1.0625rem;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }

  .tags__link:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.22em;
  }

  .tags__count {
    font-family: var(--mono);
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .tags__empty {
    color: var(--muted);
    border-top: 1px solid var(--rule);
    padding-top: var(--s5);
  }

  .tags__back {
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .tags__back a {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
