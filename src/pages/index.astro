---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/list/PostList.astro';
import { sortByDateDesc, toPostItem } from '../components/list/post-item';
import { withBase } from '../lib/url';

const published = await getCollection('research', ({ data }) => !data.draft);
const items = sortByDateDesc(published).slice(0, 8).map(toPostItem);

const description =
  'Riset keamanan aplikasi, cloud, dan red team — catatan analisis yang bisa direproduksi.';
---

<Base title="kagurasaka" description={description}>
  <div class="wrap home">
    <header class="home__id">
      <h1 class="home__name">kagurasaka</h1>
      <p class="home__position">
        Riset keamanan aplikasi, cloud, dan red team — ditulis dengan bukti yang bisa
        direproduksi ulang.
      </p>
    </header>

    <section class="home__section" aria-labelledby="terbaru">
      <p class="eyebrow" id="terbaru">Riset terbaru</p>
      <PostList
        items={items}
        emptyText="Arsip sedang disusun. Riset pertama akan muncul di sini begitu terbit."
      />
    </section>

    <nav class="home__links" aria-label="Tautan arsip">
      <a href={withBase('/research/')}>Semua riset →</a>
      <a href={withBase('/rss.xml')}>RSS</a>
    </nav>
  </div>
</Base>

<style>
  .home__id {
    padding-bottom: var(--s6);
    margin-bottom: var(--s6);
    border-bottom: 1px solid var(--rule);
  }

  .home__name {
    margin: 0 0 var(--s2);
    font-size: clamp(1.75rem, 1.5rem + 1vw, 2.125rem);
    letter-spacing: -0.02em;
  }

  .home__position {
    margin: 0;
    max-width: var(--measure);
    color: var(--muted);
  }

  .home__section {
    margin-bottom: var(--s6);
  }

  .home__section .eyebrow {
    margin-bottom: var(--s4);
  }

  .home__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s5);
    font-family: var(--mono);
    font-size: 0.8125rem;
    padding-top: var(--s5);
    border-top: 1px solid var(--rule);
  }

  .home__links a {
    color: var(--ink);
    text-decoration-color: var(--accent);
  }
</style>
